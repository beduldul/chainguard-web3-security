{
  "manifest_version": 3,
  "name": "ChainGuard - Web3 Transaction Guardian",
  "version": "1.0.0",
  "description": "Onchain security firewall intercepting EVM transactions and warning users before wallet signature.",
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChainGuard Firewall Status"
  }
}
